 "css": "/* BSP Requisition print CSS */\n@media print {\n\t@page {\n\t\tsize: A4 portrait;\n\t\tmargin: 0;\n\t}\n\n\thtml,\n\tbody {\n\t\theight: auto !important;\n\t\toverflow: visible !important;\n\t\tpadding: 10mm 10mm 160px 10mm !important;\n\t}\n\n\t.print-format-gutter {\n\t\tpadding: 0 !important;\n\t\tbackground: #fff !important;\n\t}\n\n\t.print-format {\n\t\tpadding: 0 !important;\n\t\tmargin: 0 !important;\n\t\tmin-height: 0 !important;\n\t\tmax-width: none !important;\n\t\twidth: 100% !important;\n\t\tborder-radius: 0 !important;\n\t\tbox-shadow: none !important;\n\t}\n\n\t#header-html,\n\t#footer-html,\n\tfooter,\n\t.bsp-print-footer {\n\t\tdisplay: block !important;\n\t}\n\n\t.page-number,\n\t.visible-pdf.page-number {\n\t\tdisplay: none !important;\n\t}\n\n\t.bsp-print-spacer {\n\t\tpadding-bottom: 12px !important;\n\t\tmin-height: 0 !important;\n\t}\n\n\ttable.table-bordered {\n\t\tpage-break-inside: auto;\n\t}\n\n\ttable.table-bordered tr {\n\t\tpage-break-inside: avoid;\n\t}\n\n\tfooter {\n\t\tposition: fixed;\n\t\tbottom: 10mm;\n\t\tleft: 0;\n\t\tright: 0;\n\t\twidth: 100%;\n\t\tpadding: 0 10mm;\n\t\tbackground: #fff;\n\t\tpage-break-inside: avoid;\n\t}\n}\n",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Requisition",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- BSP icon watermark: fixed full-page + flex center -->\n<div style=\"position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 0;\">\n    <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1782278204/bsp-icon_rccjk2.png\" style=\"width: 500px; opacity: 0.10; margin-left: 80px;\">\n</div>\n\n<style class=\"bsp-requisition-print-style\">@media print{.print-format-gutter{padding:0!important}.print-format{padding:0!important;min-height:0!important}#footer-html,#header-html{display:block!important}}</style>\n\n<div id=\"header-html\" class=\"hidden-pdf row section-break\" style=\"margin-bottom: 10px; border-bottom: 3px solid #1b5e20; padding-bottom: 8px;\">\n    <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1782279760/WhatsApp_Image_2026-06-17_at_4.54.27_PM_h6ey2g.jpg\" style=\"width: 100%; display: block;\">\n    <h3 style=\"text-align: center; font-weight: bold; font-size: 18px; margin: 10px 0 4px 0; letter-spacing: 0.5px;\">Requisition Form</h3>\n</div>\n\n<table class=\"table table-bordered\" style=\"margin-bottom: 10px;\">\n    <tbody>\n        <tr>\n            <td style=\"width: 50%; padding: 6px 10px; vertical-align: middle;\">\n                <b>Requisition No:</b> {{ doc.name }}\n            </td>\n            <td style=\"width: 50%; padding: 6px 10px; vertical-align: middle;\">\n                <b>Date:</b> {{ doc.get_formatted(\"transaction_date\") }}<br>\n                <b>Time:</b> {{ frappe.utils.get_datetime(doc.creation).strftime('%I:%M %p') }}\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>Requested By (From):</b> {{ frappe.get_fullname(doc.requested_by) if doc.requested_by else \"\" }}\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>Requested To:</b> {{ doc.target_warehouse or \"\" }}\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>Requisition Purpose:</b> {{ doc.notes or \"\" }}\n            </td>\n        </tr>\n    </tbody>\n</table>\n\n<div style=\"text-align: center; margin: 12px 0 10px 0;\">\n    <div style=\"color: #1b5e20; font-weight: bold; font-size: 14px; text-decoration: underline; margin-bottom: 8px;\">Requisition Status</div>\n    {%- set wf_status = doc.transfer_status or (\"Submitted\" if doc.docstatus == 1 else (\"Cancelled\" if doc.docstatus == 2 else \"Draft\")) -%}\n    {%- if wf_status in [\"Received\", \"Approved\"] -%}{%- set sc = \"#1b5e20\" -%}\n    {%- elif wf_status in [\"Rejected\", \"Cancelled\"] -%}{%- set sc = \"red\" -%}\n    {%- elif wf_status in [\"Sent\", \"Submitted\", \"Partial\"] -%}{%- set sc = \"#1565c0\" -%}\n    {%- else -%}{%- set sc = \"#666\" -%}\n    {%- endif -%}\n    <span style=\"color: {{ sc }}; border: 2px solid {{ sc }}; padding: 4px 18px; font-weight: bold; border-radius: 3px; font-size: 12px; text-transform: uppercase;\">\n        {{ wf_status }}\n    </span>\n</div>\n\n<table class=\"table table-bordered\" style=\"margin-top: 12px; font-size: 12px;\">\n    <thead style=\"background-color: #f8f9fa;\">\n        <tr>\n            <th class=\"text-center\" style=\"width: 4%;  padding: 6px 4px;\">S.L</th>\n            <th class=\"text-center\" style=\"width: 11%; padding: 6px 4px;\">Item Group</th>\n            <th class=\"text-center\" style=\"width: 12%; padding: 6px 4px;\">Item Code</th>\n            <th class=\"text-left\"   style=\"width: 28%; padding: 6px 4px;\">Item Name</th>\n            <th class=\"text-center\" style=\"width: 10%; padding: 6px 4px;\">Stock Quantity</th>\n            <th class=\"text-center\" style=\"width: 10%; padding: 6px 4px;\">Required Quantity</th>\n            <th class=\"text-center\" style=\"width: 13%; padding: 6px 4px;\">Required Date</th>\n            <th class=\"text-center\" style=\"width: 7%;  padding: 6px 4px;\">UOM</th>\n        </tr>\n    </thead>\n    <tbody>\n        {%- for row in doc.items -%}\n        {%- set stock_qty = frappe.db.get_value(\"Bin\", {\"item_code\": row.item_code, \"warehouse\": doc.source_warehouse}, \"actual_qty\") or 0 -%}\n        <tr>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.idx }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.item_group or \"\" }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.item_code }}</td>\n            <td class=\"text-left\"   style=\"padding: 5px 4px;\">{{ row.item_name }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ stock_qty | int }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.required_qty | int }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.get_formatted(\"schedule_date\") if row.schedule_date else \"\" }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.uom }}</td>\n        </tr>\n        {%- endfor -%}\n    </tbody>\n</table>\n\n<div style=\"margin-top: 10px; font-size: 13px; line-height: 1.8;\">\n    <p style=\"margin: 0;\"><b>Total Items:</b> {{ \"%02d\" | format(doc.items | length) }}</p>\n    <p style=\"margin: 0;\"><b>Total Quantity:</b> {{ doc.items | sum(attribute=\"required_qty\") | int }}</p>\n</div>\n\n<div class=\"row section-break bsp-print-spacer\" style=\"margin: 0 !important; padding-bottom: 20px !important;\"></div>\n\n<footer>\n    <div id=\"footer-html\" class=\"bsp-print-footer\">\n        <div class=\"letter-head-footer\" style=\"margin-top: 30px; padding-bottom: 5px;\">\n            <div style=\"float: left; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\">\n                    <b>Requested By</b>\n                </div>\n            </div>\n            <div style=\"float: right; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\">\n                    <b>Approved By</b>\n                </div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n\n        <div class=\"text-center\" style=\"border-top: 1px solid #ddd; padding-top: 10px; margin-top: 10px;\">\n            <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1779259109/bsp-icon_cjpf1b.png\" style=\"height: 35px; vertical-align: middle; margin-right: 12px;\">\n            <span style=\"font-size: 12px; color: #555; vertical-align: middle;\">\n                362 Mirhazirbag, Dhaka 1204, Bangladesh | +880 1866 991 307 | info@bspengineeringworks.com\n            </span>\n        </div>\n\n        <p class=\"text-center small page-number visible-pdf\" style=\"margin-top: 10px;\">\n            Page <span class=\"page\"></span> of <span class=\"topage\"></span>\n        </p>\n    </div>\n</footer>",
