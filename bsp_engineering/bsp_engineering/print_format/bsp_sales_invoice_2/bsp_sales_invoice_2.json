 "html": "<div id=\"header-html\" class=\"hidden-pdf row section-break\" style=\"border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px;\">\n    <div class=\"row\">\n        <div class=\"col-xs-6\">\n            <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1779258941/bsp-logo_cx4ene.png\" style=\"max-height: 70px; max-width: 100%;\">\n        </div>\n        <div class=\"col-xs-6 text-right\">\n            <h3 style=\"margin-top: 0; margin-bottom: 5px; font-weight: bold; color: #333;\">BSP Engineering Works</h3>\n            <p style=\"margin: 0; font-size: 12px;\">362 Mirhazirbag, Dhaka 1204, Bangladesh</p>\n            <p style=\"margin: 0; font-size: 12px;\">\ud83d\udcde +880 1805 955 902</p>\n            <p style=\"margin: 0; font-size: 12px;\">\u2709\ufe0f info@bspengineeringworks.com</p>\n        </div>\n    </div>\n    \n    <div class=\"print-heading\" style=\"padding-bottom: 6px !important; margin-bottom: 3px; margin-top: 15px;\">\n        <div class=\"2nd-head\" style=\"padding-top: 6px !important;\">\n            <p style=\"display: inline-block; text-align: left; width: 33%;\"><b>{{ doc.name }}</b></p>\n            <p style=\"display: inline-block; text-align: center; width: 32%; font-size: 16px;\"><b>INVOICE</b></p>\n            <p style=\"display: inline-block; text-align: right; width: 33%;\">{{ doc.get_formatted(\"territory\") }}</p>\n        </div> \n        \n        <div class=\"text-center\" style=\"margin-top: 5px;\">\n            {%- set status_color = 'red' -%}\n            {%- if doc.status == 'Paid' -%} {%- set status_color = 'green' -%}\n            {%- elif doc.status == 'Partially Paid' -%} {%- set status_color = '#ff9900' -%}\n            {%- elif doc.status == 'Unpaid' or doc.status == 'Overdue' -%} {%- set status_color = 'red' -%}\n            {%- else -%} {%- set status_color = '#666' -%}\n            {%- endif -%}\n            <span style=\"color: {{ status_color }}; border: 2px solid {{ status_color }}; padding: 3px 10px; font-weight: bold; border-radius: 3px; font-size: 12px; text-transform: uppercase;\">\n                {{ doc.status }}\n            </span>\n        </div>\n    </div>\n</div>\n\n<div class=\"row section-break\" style=\"margin: 0px !important\">\n    <table class=\"col-xs-6\">\n        <tr>\n            <td style=\"padding: 0px !important; width: 25%;\"><b>Customer</b></td>\n            <td class=\"text-center\" style=\"padding: 0px 10px !important;\">:</td>\n            <td style=\"padding: 0px !important;\"><b>{{ doc.get_formatted(\"customer_name\") }}</b></td>\n        </tr>\n        {%- if doc.address_display -%}\n        <tr>\n            <td style=\"padding: 0px !important; vertical-align: top;\">Address</td>\n            <td style=\"padding: 0px 10px !important; vertical-align: top;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\">{{ doc.get_formatted(\"address_display\") }}</td>\n        </tr>\n        {%- endif %}\n        {%- if doc.contact_display -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">Contact</td>\n            <td style=\"padding: 0px 10px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\">{{ doc.get_formatted(\"contact_display\") }}</td>\n        </tr>\n        {%- endif %}\n        {%- if doc.contact_mobile -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">Mobile No</td>\n            <td style=\"padding: 0px 10px !important;\" class=\"text-center\">:</td>  \n            <td style=\"padding: 0px !important;\">{{ doc.get_formatted(\"contact_mobile\") }}</td>\n        </tr>\n        {%- endif %}\n    </table>\n\n    <table class=\"col-xs-1\">\n        <tr><td></td></tr>\n    </table>\n\n    <table class=\"col-xs-5\">\n        <tr>\n            <td style=\"padding: 0px !important;\" >Posting Date</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ doc.get_formatted(\"posting_date\") }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 0px !important;\">Due Date</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ doc.get_formatted(\"due_date\") }}</td>\n        </tr>\n        {%- if doc.po_date -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">PO Date</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ doc.get_formatted(\"po_date\") }}</td>\n        </tr>\n        {%- endif %}\n        {%- if doc.po_no -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">PO Details</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ doc.get_formatted(\"po_no\") }}</td>\n        </tr>\n        {%- endif -%}\n        {%- for row in doc.sales_team -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">Sold By</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ row.sales_person }}</td>\n        </tr>\n        {%- endfor -%}\n        <tr>\n            <td style=\"padding: 0px !important;\">Created By</td>\n            <td style=\"padding: 0px !important;\" class=\"text-center\">:</td>\n            <td style=\"padding: 0px !important;\" class=\"text-right\">{{ frappe.get_fullname(doc.owner) }}</td>\n        </tr>\n    </table>\n</div>\n\n<table class=\"table table-bordered\" style=\"margin-top: 15px;\">\n    <thead style=\"background-color: #f8f9fa;\">\n        <tr>\n            <th class=\"text-left\" style=\"width: 5%;\">Sl.</th>\n            <th class=\"text-left\" style=\"width: 50%;\">Item Name</th>\n            <th class=\"text-right\" style=\"width: 10%;\">Qty</th>\n            <th class=\"text-right\" style=\"width: 15%;\">Rate</th>\n            <th class=\"text-right\" style=\"width: 20%;\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {%- for row in doc.items -%}\n        <tr>\n            <td class=\"text-left\">{{ row.idx }}</td>\n            <td class=\"text-left\">{{ row.item_name }}</td>\n            <td class=\"text-right\">{{ row.qty }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"rate\", doc) }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\n        </tr>                           \n        {%- endfor -%}\n        \n        {%- if doc.total_qty -%}\n        <tr>\n            <td colspan=\"2\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\">Total Qty</td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important;\">{{ doc.get_formatted(\"total_qty\") }}</td>\n            <td colspan=\"2\" style=\"padding: 6px !important;\"></td>\n        </tr>\n        {%- endif %}\n\n        {%- if doc.discount_amount -%}\n        <tr>\n            <td colspan=\"4\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\"><b>Discount</b></td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important;\"><b>{{ doc.get_formatted(\"discount_amount\") }}</b></td>\n        </tr>\n        {%- endif %}\n\n        {%- if doc.total_taxes_and_charges -%}\n        <tr>\n            <td colspan=\"4\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\">VAT</td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n        </tr>\n        {%- endif %}\n                \n        <tr>\n            <td colspan=\"4\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\"><b>Grand Total</b></td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important;\"><b>{{ doc.get_formatted(\"grand_total\") }}</b></td>\n        </tr>\n        \n        {% set paid_amount = doc.grand_total - doc.outstanding_amount %}\n        <tr>\n            <td colspan=\"4\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\"><b>Total Paid</b></td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important;\">\n                <b>{{ frappe.utils.fmt_money(paid_amount, currency=doc.currency) }}</b>\n            </td>\n        </tr>\n        \n        <tr>\n            <td colspan=\"4\" class=\"text-right\" style=\"font-size: 12px; padding: 6px 8px 6px 30px !important;\"><b>Total Due</b></td>\n            <td class=\"text-right\" style=\"font-size: 12px; padding: 6px !important; color: {% if doc.outstanding_amount > 0 %}red{% else %}inherit{% endif %};\">\n                <b>{{ doc.get_formatted(\"outstanding_amount\") }}</b>\n            </td>\n        </tr>\n    </tbody>\n</table>\n\n{%- if doc.packed_items -%}\n<table class=\"table table-bordered\">\n    <thead>\n        <tr style=\"background-color: #f8f9fa;\">\n            <th>Bundle Item Name</th>\n            <th class=\"text-right\">Qty</th>\n        </tr>\n    </thead>\n    <tbody>\n    {%- for i in doc.packed_items -%}\n    <tr>\n        <td>{{ i.item_name }}</td>\n        <td class=\"text-right\">{{ i.qty }}</td>              \n    </tr>\n    {%- if i.serial_no  -%}\n    <tr>\n        <td colspan=\"2\" class=\"text-left\">\n            <b>Serials: </b>{{ i.serial_no }}\n        </td>\n    </tr>\n    {%- endif %}\n    {%- endfor -%}\n    </tbody>\n</table>\n{%- endif %}\n<div class=\"row section-break\" style=\"margin: 0px !important; padding-bottom: 5px !important;\">\n    <p style=\"font-size: 12px; padding: 0px !important;\"><b>Amount In Words : </b> {{ doc.get_formatted(\"in_words\") }}</p>\n</div>\n\n<div class=\"row section-break\" style=\"margin: 0px !important; padding-bottom: 80px !important;\">\n    {%- if doc.remarks and doc.remarks != \"No Remarks\" -%}\n    <p style=\"font-size: 12px;\"><b>Remarks : </b>{{ doc.get_formatted(\"remarks\") }}</p>\n    {%- endif %}\n</div>\n\n\n<footer>\n    <div id=\"footer-html\" class=\"visible-pdf\" style=\"display: block !important; order: 1;\">\n        \n        <div class=\"letter-head-footer\" style=\"margin-top: 40px; padding-bottom: 5px;\">\n            <div style=\"float: left; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\">\n                    <b>Received in good condition by</b>\n                </div>\n            </div>\n            \n            <div style=\"float: right; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\">\n                    <b>For BSP Engineering Works</b>\n                </div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n\n        <div class=\"text-center\" style=\"border-top: 1px solid #ddd; padding-top: 10px; margin-top: 10px;\">\n            <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1779259109/bsp-icon_cjpf1b.png\" style=\"height: 35px; vertical-align: middle; margin-right: 12px;\">\n            <span style=\"font-size: 12px; color: #555; vertical-align: middle;\">\n                362 Mirhazirbag, Dhaka 1204, Bangladesh | +880 1805 955 902 | info@bspengineeringworks.com\n            </span>\n        </div>\n\n        <p class=\"text-center small page-number visible-pdf\" style=\"margin-top: 10px;\">\n            Page <span class=\"page\"></span> of <span class=\"topage\"></span>\n        </p>\n    </div>\n</footer>",
