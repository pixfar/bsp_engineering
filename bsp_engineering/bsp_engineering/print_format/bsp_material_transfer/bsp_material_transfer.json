 "creation": "2026-07-12 11:05:20.088514",
 "css": "/* Force visible black table borders (default is a faint #d1d8dd) */\n.print-format table.table-bordered,\n.print-format table.table-bordered > thead > tr > th,\n.print-format table.table-bordered > thead > tr > td,\n.print-format table.table-bordered > tbody > tr > th,\n.print-format table.table-bordered > tbody > tr > td {\n\tborder: 1px solid #000 !important;\n}\n\n/* BSP Material Transfer print CSS (real PDF generation via wkhtmltopdf) */\n@media print {\n\t.print-format-gutter { padding: 0 !important; background: #fff !important; }\n\t.print-format { padding: 0 !important; margin: 0 !important; min-height: 0 !important; max-width: none !important; width: 100% !important; border-radius: 0 !important; box-shadow: none !important; }\n\t#header-html, #footer-html, footer, .bsp-print-footer { display: block !important; }\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Material Transfer",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- BSP icon watermark -->\n<div style=\"position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 0;\">\n    <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1782278204/bsp-icon_rccjk2.png\" style=\"width: 500px; opacity: 0.10; margin-left: 80px;\">\n</div>\n\n<style class=\"bsp-mt-style\">@media print{.print-format-gutter{padding:0!important}.print-format{padding:0!important;min-height:0!important}#footer-html,#header-html{display:block!important}}.bsp-header-inner{position:relative;top:-13mm}</style>\n\n<div id=\"header-html\" class=\"hidden-pdf row section-break\" style=\"margin-bottom: 10px; border-bottom: 3px solid #1b5e20; padding-bottom: 8px;\"><div class=\"bsp-header-inner\">\n    <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1783836475/WhatsApp_Image_2026-07-10_at_9.48.23_PM_fn8g8h.jpg\" style=\"width: 100%; display: block;\">\n    <h3 style=\"text-align: center; font-weight: bold; font-size: 18px; margin: 10px 0 4px 0; letter-spacing: 0.5px;\">Material Transfer</h3>\n</div></div>\n\n<table class=\"table table-bordered\" style=\"margin-bottom: 10px;\">\n    <tbody>\n        <tr>\n            <td style=\"width: 50%; padding: 6px 10px; vertical-align: middle;\">\n                <b>Material Transfer No:</b> {{ doc.name }}\n            </td>\n            <td style=\"width: 50%; padding: 6px 10px; vertical-align: middle;\">\n                <b>Date:</b> {{ doc.transaction_date }}<br>\n                <b>Time:</b> {{ frappe.utils.get_datetime(doc.creation).strftime('%I:%M %p') }}\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>Requested By:</b> {{ doc.requested_by or \"\" }}\n            </td>\n        </tr>\n        {%- if doc.from_warehouse %}\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>From Warehouse:</b> {{ doc.from_warehouse }}\n            </td>\n        </tr>\n        {%- endif %}\n        {%- if doc.to_warehouse %}\n        <tr>\n            <td colspan=\"2\" style=\"padding: 6px 10px;\">\n                <b>To Warehouse:</b> {{ doc.to_warehouse }}\n            </td>\n        </tr>\n        {%- endif %}\n    </tbody>\n</table>\n\n<div style=\"text-align: center; margin: 12px 0 10px 0;\">\n    <div style=\"color: #1b5e20; font-weight: bold; font-size: 14px; text-decoration: underline; margin-bottom: 8px;\">Transfer Status</div>\n    {%- set st = doc.transfer_status or (\"Cancelled\" if doc.docstatus == 2 else \"Draft\") -%}\n    {%- if st == \"Fully Received\" -%}{%- set sc = \"#1b5e20\" -%}\n    {%- elif st == \"Partially Received\" -%}{%- set sc = \"#e65100\" -%}\n    {%- elif st == \"In Transit\" -%}{%- set sc = \"#1565c0\" -%}\n    {%- elif st == \"Cancelled\" -%}{%- set sc = \"red\" -%}\n    {%- else -%}{%- set sc = \"#666\" -%}\n    {%- endif -%}\n    <span style=\"color: {{ sc }}; border: 2px solid {{ sc }}; padding: 4px 18px; font-weight: bold; border-radius: 3px; font-size: 12px; text-transform: uppercase;\">\n        {{ st }}\n    </span>\n</div>\n\n<table class=\"table table-bordered\" style=\"margin-top: 12px; font-size: 12px;\">\n    <thead style=\"background-color: #f8f9fa;\">\n        <tr>\n            <th class=\"text-center\" style=\"width: 4%;  padding: 6px 4px;\">S.L</th>\n            <th class=\"text-center\" style=\"width: 12%; padding: 6px 4px;\">Item Code</th>\n            <th class=\"text-left\"   style=\"width: 26%; padding: 6px 4px;\">Item Name</th>\n            <th class=\"text-center\" style=\"width: 12%; padding: 6px 4px;\">Item Group</th>\n            <th class=\"text-center\" style=\"width: 11%; padding: 6px 4px;\">Qty</th>\n            <th class=\"text-center\" style=\"width: 11%; padding: 6px 4px;\">Received Qty</th>\n            <th class=\"text-center\" style=\"width: 7%;  padding: 6px 4px;\">UOM</th>\n            <th class=\"text-center\" style=\"width: 13%; padding: 6px 4px;\">Required Date</th>\n        </tr>\n    </thead>\n    <tbody>\n        {%- for row in doc.items -%}\n        <tr>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.idx }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.item_code or \"\" }}</td>\n            <td class=\"text-left\"   style=\"padding: 5px 4px;\">{{ row.item_name or \"\" }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.item_group or \"\" }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ (row.qty or 0) | int }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ (row.received_qty or 0) | int }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.uom or \"\" }}</td>\n            <td class=\"text-center\" style=\"padding: 5px 4px;\">{{ row.schedule_date or \"\" }}</td>\n        </tr>\n        {%- endfor -%}\n    </tbody>\n</table>\n\n<div style=\"margin-top: 10px; font-size: 13px; line-height: 1.8;\">\n    <p style=\"margin: 0;\"><b>Total Items:</b> {{ \"%02d\" | format(doc.items | length) }}</p>\n    <p style=\"margin: 0;\"><b>Total Quantity:</b> {{ doc.items | sum(attribute=\"qty\") | int }}</p>\n</div>\n\n<div class=\"row section-break\" style=\"margin: 0 !important; padding-bottom: 20px !important;\"></div>\n\n<footer>\n    <div id=\"footer-html\" class=\"bsp-print-footer\">\n        <div class=\"letter-head-footer\" style=\"margin-top: 30px; padding-bottom: 5px;\">\n            <div style=\"float: left; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\"><b>Prepared By</b></div>\n            </div>\n            <div style=\"float: right; width: 35%;\">\n                <div style=\"border-top: 1px solid #000; padding-top: 5px; text-align: center;\"><b>Approved By</b></div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n        <div class=\"text-center\" style=\"border-top: 1px solid #ddd; padding-top: 10px; margin-top: 10px;\">\n            <img src=\"https://res.cloudinary.com/dydfwvvro/image/upload/v1779259109/bsp-icon_cjpf1b.png\" style=\"height: 35px; vertical-align: middle; margin-right: 12px;\">\n            <span style=\"font-size: 12px; color: #555; vertical-align: middle;\">362 Mirhazirbag, Dhaka 1204, Bangladesh | +880 1805 955 902 | info@bspengineeringworks.com</span>\n        </div>\n    </div>\n</footer>",
